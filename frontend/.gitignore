# ==========================================
# StudyVault - Full Stack .gitignore
# ==========================================

# ---------- Dependencies ----------
node_modules/

# ---------- Environment Variables ----------
.env
.env.local
.env.development
.env.production
.env.test

# ---------- Build / Production ----------
dist/
build/
.vite/

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Coverage ----------
coverage/
.nyc_output/

# ---------- OS Files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE / Editor ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.swp
*.swo

# ---------- Temporary Files ----------
*.tmp
*.temp
*.bak

# ---------- Local Database ----------
*.sqlite
*.sqlite3
*.db

# ---------- Test / Cache ----------
.cache/
.parcel-cache/
.eslintcache

# ---------- TypeScript ----------
*.tsbuildinfo